{
  "manifest_version": 3,
  "name": "PR Guardian",
  "version": "1.0.0",
  "description": "Prevents merging GitHub pull requests with multiple commits",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*/pull/*"
      ],
      "js": ["config.js", "features/multi-commit.js", "features/version-bump.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
